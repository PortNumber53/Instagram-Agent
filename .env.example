# NVIDIA NIM API Key (get from https://build.nvidia.com/)
NVIDIA_API_KEY=nvapi-xxxxx

# Facebook App credentials for Instagram Graph API
# Get these from https://developers.facebook.com/apps/
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret

# Instagram access token & account ID — set automatically by 'instagram-agent auth'
# You can also set these manually if you already have a long-lived token.
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=
